# HoneyGate — Plantilla de variables de entorno (sin secretos ni credenciales reales).
# Copiar a `.env` antes de usar con `systemd` o exportar manualmente en shell.
# Si se dejan vacías, el daemon aplica los valores por defecto documentados en README.md.

# API y panel administrativo
HONEYGATE_API_TOKEN=
HONEYGATE_API_HOST=
HONEYGATE_API_PORT=

# Motor epoll y servicios emulados
HONEYGATE_EPOLL_HOST=
HONEYGATE_HEADLESS=

# Portal cautivo (Modo 1) y clave HMAC
HONEYGATE_PORTAL_HOST=
HONEYGATE_PORTAL_PORT=
HONEYGATE_PORTAL_SECRET=
HONEYGATE_PORTAL_LAB_MODE=
HONEYGATE_PORTAL_OTP_OPTIONAL=

# Salida SMTP para envío de códigos OTP del portal
HONEYGATE_SMTP_HOST=
HONEYGATE_SMTP_PORT=
HONEYGATE_SMTP_USER=
HONEYGATE_SMTP_PASS=
HONEYGATE_SMTP_PASSWORD=
HONEYGATE_SMTP_FROM=
HONEYGATE_SMTP_USE_TLS=
HONEYGATE_SMTP_USE_SSL=

# Reglas externas MITRE ATT&CK
HONEYGATE_MITRE_RULES_PATH=
